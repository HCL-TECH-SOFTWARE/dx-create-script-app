# ---------------------------------------------------------------------------
# Requires npm >= 11.19.1 (bundled with Node 24). Do not remove or weaken
# these lines without PAA sign-off.
# Must exist in EVERY package directory, not just the repo root — npm will
# not read a parent directory's .npmrc past a package.json.
# ---------------------------------------------------------------------------
 
# Refuse any package version published less than 7 days ago.
min-release-age=7
 
# Our own scope is exempt: internal releases must be installable immediately.
min-release-age-exclude[]=@enchanted/*
min-release-age-exclude[]=@enchanted-prod/*
min-release-age-exclude[]=@hcl-software/*
 
# Write exact versions on `npm install <pkg>` — no leading caret.
save-exact=true
